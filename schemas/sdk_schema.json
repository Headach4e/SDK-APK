{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SDKDatabase",
  "type": "object",
  "required": ["sdks"],
  "properties": {
    "sdks": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "package_prefixes",
          "manifest_signatures",
          "native_libs",
          "official_repo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9\\-_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "category": {
            "type": "string",
            "enum": [
              "analytics",
              "push",
              "payments",
              "maps",
              "auth",
              "ads",
              "crash_reporting",
              "utility"
            ]
          },
          "package_prefixes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "manifest_signatures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "native_libs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "official_repo": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
